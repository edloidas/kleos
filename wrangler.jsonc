{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleos",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Deploying creates the DNS record and certificate on the edloidas.io zone.
  "routes": [{ "pattern": "kleos.edloidas.io", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Organizations the leaderboard is enabled for. Anything else lands on the waitlist.
    "SUPPORTED_ORGS": "enonic,anomalyco,enonic-playground,biomejs,denoland,oven-sh,pnpm,prettier,sveltejs,tanstack,vitejs,withastro,zed-industries",
    // The few the front page offers as links. Outside this list an organization is
    // reachable only by name; anything not also in SUPPORTED_ORGS is ignored.
    "FEATURED_ORGS": "enonic,anomalyco,pnpm,oven-sh"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "db5b5ed5a080488793bea29be2cb45d1"
    }
  ],
  "ratelimits": [
    {
      // Uncached account lookups one visitor can force. `namespace_id` is just a
      // name within this Worker and provisions nothing.
      "name": "LOOKUP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kleos",
      "database_id": "5e5ff4b3-e6d3-4567-88e6-6b390dc83079"
    }
  ]
}
