{
  "name": "kleos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glory won by deeds — contribution leaderboards for GitHub organizations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/ensure-fixture.mjs && wrangler types && astro dev",
    "build": "node scripts/ensure-fixture.mjs --strict && wrangler types && astro build",
    "preview": "node scripts/ensure-fixture.mjs --strict && astro build && wrangler dev",
    "deploy": "node scripts/ensure-fixture.mjs --strict && astro build && wrangler deploy",
    "check": "node scripts/ensure-fixture.mjs && pnpm --no-bail run /^check:/",
    "check:types": "node scripts/ensure-fixture.mjs && wrangler types && astro check",
    "check:lint": "oxlint -c .oxlintrc.json",
    "check:format": "oxfmt -c .oxfmtrc.json --check .",
    "check:test": "vitest run",
    "lint": "oxlint -c .oxlintrc.json --fix",
    "format": "oxfmt -c .oxfmtrc.json .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:local": "wrangler d1 execute kleos --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute kleos --remote --file=./schema.sql",
    "snapshot": "tsx scripts/snapshot.ts",
    "fixture": "node scripts/ensure-fixture.mjs",
    "clean": "node scripts/clean-dev.mjs"
  },
  "nano-staged": {
    "*": "node scripts/guard-staged.mjs",
    "*.{ts,tsx}": [
      "oxfmt -c .oxfmtrc.json --write",
      "oxlint -c .oxlintrc.json"
    ],
    "*.astro": "oxlint -c .oxlintrc.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  }
}
