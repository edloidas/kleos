---
// Sticky, not fixed: in flow it reserves its own height, and it still floats over
// the content that scrolls under it.
const control =
  'pointer-events-auto flex size-11 cursor-pointer items-center justify-center rounded-2xl border border-line bg-veil text-ink shadow-raised-sm backdrop-blur-md transition-transform duration-150 outline-none hover:scale-105 focus-visible:ring-2 focus-visible:ring-bronze active:scale-95 active:shadow-pressed-sm [&_svg]:size-5 [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:stroke-2 [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-linejoin:round]';

// The front page has nowhere to go home to, so an empty cell holds the toggle on
// the right.
const atHome = Astro.url.pathname === '/';
---

<div class="pointer-events-none sticky top-0 z-50 flex items-center justify-between gap-3 pt-3 sm:py-5">
  {
    atHome ? (
      <span class="size-11" aria-hidden="true" />
    ) : (
      <a href="/" class={control} aria-label="Home" title="Home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
          <path
            d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
          />
        </svg>
      </a>
    )
  }

  <slot />

  <button
    type="button"
    class={control}
    aria-label="Switch theme"
    title="Switch theme"
    data-theme-toggle
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden [[data-theme='system']_&]:block">
      <path d="M12 2v2"></path>
      <path
        d="M14.837 16.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715"
      ></path>
      <path d="M16 12a4 4 0 0 0-4-4"></path>
      <path d="m19 5-1.256 1.256"></path>
      <path d="M20 12h2"></path>
    </svg>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden [[data-theme='light']_&]:block">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden [[data-theme='dark']_&]:block">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </button>
</div>

<script>
  import { enhanceThemeToggle } from './theme.client';

  const toggle = document.querySelector<HTMLElement>('[data-theme-toggle]');

  if (toggle) enhanceThemeToggle(toggle);
</script>
