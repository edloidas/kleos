---
interface Props {
  org: string;
  requested?: boolean;
}

const { org, requested = false } = Astro.props;
---

<section class="max-w-prose">
  {requested && <p class="mb-6 text-sm text-bronze">Thanks — we will let you know.</p>}

  <h2 class="font-display text-2xl">Not enabled yet</h2>
  <p class="mt-2 text-muted">
    <strong class="text-ink">{org}</strong> is not on the list. Leave an email and we will tell
    you when it is.
  </p>

  <form method="post" action="/api/waitlist" class="mt-6 flex gap-2">
    <input type="hidden" name="org" value={org} />
    <input
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      class="pressed flex-1 rounded-2xl border border-line px-4 py-3 text-ink outline-none placeholder:text-muted focus:ring-2 focus:ring-bronze"
    />
    <button
      type="submit"
      class="shadow-raised rounded-2xl border border-bronze bg-laurel px-5 py-3 font-medium text-on-laurel transition-transform duration-150 hover:scale-[1.02] focus-visible:ring-2 focus-visible:ring-bronze focus-visible:outline-none active:scale-95 active:shadow-pressed-sm"
    >
      Notify me
    </button>
  </form>
</section>
