---
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';
import { supportedOrgs } from '../lib/orgs';

const orgs = supportedOrgs();

// The form submits here with ?org=; redirecting server-side means the lookup
// works with scripting disabled, and the inline script below is only a shortcut.
const requestedOrg = Astro.url.searchParams.get('org')?.trim();

if (requestedOrg) {
  return Astro.redirect(`/${encodeURIComponent(requestedOrg)}`, 303);
}
---

<Base title="kleos — contribution leaderboards for GitHub organizations">
  <Mark slot="header" />

  <div class="mx-auto max-w-md text-center">
    <form
      method="get"
      action="/"
      class="pressed flex items-center rounded-2xl border border-line focus-within:ring-2 focus-within:ring-bronze"
      data-form-type="other"
      data-org-form
    >
      <input
        type="text"
        name="org"
        placeholder="Organization name"
        required
        aria-label="GitHub organization"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        data-1p-ignore
        data-lpignore="true"
        data-bwignore
        data-form-type="other"
        class="min-w-0 flex-1 bg-transparent py-3.5 pr-2 pl-5 text-ink outline-none placeholder:text-faint"
      />
      <button
        type="submit"
        class="mr-1.5 grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-line bg-veil text-ink shadow-raised-sm backdrop-blur-md transition-transform duration-150 outline-none hover:scale-105 focus-visible:ring-2 focus-visible:ring-bronze active:scale-95 active:shadow-pressed-sm"
        aria-label="Look up"
        title="Look up"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="size-5 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>

    {
      orgs.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm">
          {orgs.map((org) => (
            <a
              href={`/${org}`}
              class="raised cursor-pointer rounded-lg border border-line px-3 py-1.5 text-ink transition-[color,box-shadow,scale] duration-150 outline-none hover:text-ember focus-visible:text-ember focus-visible:ring-2 focus-visible:ring-bronze active:scale-[0.98] active:shadow-none"
            >
              {org}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <footer slot="footer" class="mt-16 text-center text-xs leading-relaxed text-muted">
    <p>
      Contributors are ranked by pull requests, reviews, issues and commits. Only public
      contributions are counted.
    </p>
  </footer>

  <script>
    // The form has no server route of its own; it just navigates to /:org.
    document.querySelector('[data-org-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = (event.currentTarget as HTMLFormElement).elements.namedItem(
        'org',
      ) as HTMLInputElement;
      const org = input.value.trim();

      if (org) {
        window.location.href = `/${encodeURIComponent(org)}`;
      }
    });
  </script>
</Base>
