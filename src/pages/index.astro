---
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';
import { supportedOrgs } from '../lib/orgs';

const orgs = supportedOrgs();

// The form submits here with ?org=; redirecting server-side means the lookup
// works with scripting disabled, and the inline script below is only a shortcut.
const requestedOrg = Astro.url.searchParams.get('org')?.trim();

if (requestedOrg) {
  return Astro.redirect(`/${encodeURIComponent(requestedOrg)}`, 303);
}
---

<Base title="kleos — contribution leaderboards for GitHub organizations">
  <Mark slot="header" />

  <div class="mx-auto max-w-md text-center">
    <h1 class="font-display text-3xl leading-tight">Who carried the org?</h1>
    <p class="mt-3 text-muted">
      Enter a GitHub organization to see its contributors ranked by pull requests, reviews, issues
      and commits.
    </p>

    <form method="get" action="/" class="mt-8 flex gap-2" data-org-form>
      <input
        type="text"
        name="org"
        placeholder="enonic"
        required
        autocomplete="off"
        class="flex-1 rounded-md border border-line bg-surface px-4 py-2 outline-none focus:border-bronze"
      />
      <button
        type="submit"
        class="rounded-md bg-laurel px-5 py-2 font-medium text-ink hover:opacity-90"
      >
        Look up
      </button>
    </form>

    {
      orgs.length > 0 && (
        <p class="mt-6 text-sm text-muted">
          Enabled now:{' '}
          {orgs.map((org, index) => (
            <>
              {index > 0 && ', '}
              <a href={`/${org}`} class="text-bronze hover:underline">
                {org}
              </a>
            </>
          ))}
        </p>
      )
    }
  </div>

  <script>
    // The form has no server route of its own; it just navigates to /:org.
    document.querySelector('[data-org-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = (event.currentTarget as HTMLFormElement).elements.namedItem(
        'org',
      ) as HTMLInputElement;
      const org = input.value.trim();

      if (org) {
        window.location.href = `/${encodeURIComponent(org)}`;
      }
    });
  </script>
</Base>
