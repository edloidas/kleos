---
import { MonthLadder } from '../components/MonthLadder';
import PeriodSwitch from '../components/PeriodSwitch.astro';
import { MonthPodium, WeekPodium } from '../components/Podium';
import { Spotlight } from '../components/Spotlight';
import Waitlist from '../components/Waitlist.astro';
import { WeekStandings } from '../components/WeekStandings';
import Base from '../layouts/Base.astro';
import { resolveAccount } from '../lib/account';
import { BADGE_FLOOR, MAX_BADGES } from '../lib/badges';
import { getBoard } from '../lib/board';
import { GitHubError } from '../lib/github/client';
import { resolveViewer } from '../lib/github/token';
import { mayLookUp } from '../lib/limit';
import { excludedLogins, isSupported } from '../lib/orgs';
import { MAX_MEMBERS, MIN_MEMBERS } from '../lib/roster';
import { K_FACTOR, MIN_ROUNDS } from '../lib/rating';
import { routeFor, routeForAccount } from '../lib/route';
import { HALF_AT, WEIGHTS } from '../lib/score';
import { parseView } from '../lib/views';

const name = Astro.params.name!;
const view = parseView(Astro.url.searchParams.get('period'));
const requested = Astro.url.searchParams.has('requested');
const viewer = resolveViewer(Astro.request);

// Only a well-formed, unlisted name reaches the lookup; `routeFor` settles
// everything else without a request.
const local = routeFor(name, isSupported(name), Astro.url.search);
const route =
  local ??
  routeForAccount(
    await resolveAccount(viewer, name, () => mayLookUp(Astro.request)),
    requested,
  );

if (route.kind === 'redirect') {
  return Astro.redirect(route.to, route.status);
}

if (route.kind !== 'board') {
  Astro.response.status = route.status;
}

let board = null;
let error: string | null = null;

if (route.kind === 'board') {
  try {
    board = await getBoard(viewer, name, new Date(), excludedLogins());
  } catch (cause) {
    // The raw message carries rate-limit identifiers and internal exception text,
    // so it goes to the log and the visitor gets a status they can act on.
    console.error(`board failed for ${name}/${view}:`, cause);

    const limited = cause instanceof GitHubError && cause.rateLimited;

    error = limited
      ? 'kleos is over its GitHub rate limit right now. The board comes back within the hour.'
      : 'Could not reach GitHub. Try again in a moment.';
    Astro.response.status = limited ? 503 : 502;
  }
}

const notFound = route.kind === 'not-found';

const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const monthName = new Intl.DateTimeFormat('en-GB', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={notFound ? 'Not found — kleos' : `${name} — kleos`}
  description={notFound
    ? undefined
    : `Who carried ${name}? Contributors ranked by pull requests, reviews, issues and commits.`}
>
  {route.kind === 'board' && <PeriodSwitch slot="toolbar" name={name} view={view} />}

  {
    notFound ? (
      <section class="mt-4 max-w-prose">
        <h1 class="font-display text-4xl">Not found</h1>
        <p class="mt-4 text-muted">
          kleos has no page for <strong class="text-ink">{name}</strong>.
        </p>
      </section>
    ) : (
      <Fragment>
        <h1 class="mt-4 text-center font-display text-4xl">
          <a
            href={`https://github.com/${name}`}
            class="transition-colors duration-150 hover:text-ember hover:underline"
          >
            {name}
          </a>
        </h1>

        <div class="mt-6">
          {route.kind === 'not-enabled' && <Waitlist org={name} requested={requested} />}
          {error && <p class="text-muted">{error}</p>}

          {board?.limit === 'too-small' && (
            <p class="text-muted">
              {name} has {board.members} public {board.members === 1 ? 'member' : 'members'}. A ladder
              needs at least {MIN_MEMBERS}.
            </p>
          )}

          {board?.limit === 'too-large' && (
            <p class="text-muted">
              {name} has {board.members} public members, more than the {MAX_MEMBERS} a board is served
              for.
            </p>
          )}

          {board && !board.limit && view === 'week' && (
            <div class="space-y-4">
              <div class="text-center">
                <h2 class="font-display text-2xl">
                  Week {board.week.number}{' '}
                  <span class="text-muted">
                    ({day.format(new Date(board.week.from))} – {day.format(new Date(board.week.to))})
                  </span>
                </h2>
                <span class="mt-2 inline-block rounded-full border border-line px-2 py-0.5 text-xs text-muted">
                  {board.week.complete
                    ? 'final'
                    : `running · through ${day.format(new Date(board.week.through))}`}
                </span>
              </div>
              <WeekPodium standings={board.week.standings} />

              {board.week.spotlight.length > 0 && (
                <section class="space-y-3 pt-4">
                  <h3 class="text-center font-display text-lg">Spotlight</h3>
                  <Spotlight highlights={board.week.spotlight} />
                </section>
              )}

              <section class="space-y-3 pt-4">
                <h3 class="text-center font-display text-lg">Weekly leaderboard</h3>
                <WeekStandings standings={board.week.standings} badges={board.week.badges} />
              </section>
            </div>
          )}

          {board && !board.limit && view === 'month' && (
            <div class="space-y-4">
              <div class="text-center">
                <h2 class="font-display text-2xl">{monthName.format(new Date(board.month.start))}</h2>
                <p class="mt-2 text-sm text-muted">
                  {board.month.rounds} {board.month.rounds === 1 ? 'round' : 'rounds'} played.
                  {board.month.provisionalRound && ' Ratings include this week so far.'}
                </p>
              </div>
              <MonthPodium ranked={board.month.ranked} />

              <section class="space-y-3 pt-4">
                <h3 class="text-center font-display text-lg">Monthly ladder</h3>
                <MonthLadder month={board.month} />
              </section>
            </div>
          )}
        </div>

        {board && !board.limit && (
          <div class="mt-16 space-y-1.5 border-t border-line-soft pt-6 text-[0.6875rem] leading-relaxed text-muted">
            <p>
              Weekly points = sum of weight × n / (n + k), over PRs ({WEIGHTS.pullRequests}/
              {HALF_AT.pullRequests}), reviews ({WEIGHTS.reviews}/{HALF_AT.reviews}), issues (
              {WEIGHTS.issues}/{HALF_AT.issues}) and commits ({WEIGHTS.commits}/{HALF_AT.commits}).
            </p>
            <p>
              Rating moves by {K_FACTOR} × (expected place − actual place) / (players − 1), so beating
              the place your rating predicts gains you points; {MIN_ROUNDS} rounds are needed to be
              ranked.
            </p>
            <p>
              Up to {MAX_BADGES} badges a week, one per member. PR Machine, Gatekeeper, Scout and
              Workhorse go to whoever leads pull requests, reviews, issues or commits outright with
              at least {BADGE_FLOOR} of it. All-Rounder goes to the member with {BADGE_FLOOR} or
              more in every category whose weakest category is the strongest; Riser to the largest
              gain since last week. A lead nobody holds alone is not awarded, and a badge is never
              passed to a runner-up.
            </p>
            <p>Only public members and their public contributions are counted.</p>
          </div>
        )}
      </Fragment>
    )
  }
</Base>
